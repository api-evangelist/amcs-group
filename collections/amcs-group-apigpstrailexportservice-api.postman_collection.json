              "mode": "raw",
              "raw": "{\n  \"assetName\": \"<string>\",\n  \"gpsTrail\": [\n    {\n      \"timestamp\": \"<dateTime>\",\n      \"lat\": \"<double>\",\n      \"lon\": \"<double>\"\n    },\n    {\n      \"timestamp\": \"<dateTime>\",\n      \"lat\": \"<double>\",\n      \"lon\": \"<double>\"\n    }\n  ]\n}",
