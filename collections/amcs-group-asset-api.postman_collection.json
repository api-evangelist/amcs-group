            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"assetId\": \"<uuid>\",\n  \"assetName\": \"<string>\",\n  \"assetType\": \"<string>\",\n  \"outletId\": \"<uuid>\",\n  \"companyCode\": \"<string>\",\n  \"isDeleted\": \"<boolean>\"\n}",
