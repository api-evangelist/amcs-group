              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerSiteId\": \"<uuid>\",\n  \"name\": \"<string>\",\n  \"postalCode\": \"<string>\",\n  \"houseNumber\": \"<string>\",\n  \"address1\": \"<string>\",\n  \"address2\": \"<string>\",\n  \"address3\": \"<string>\",\n  \"address4\": \"<string>\",\n  \"address5\": \"<string>\",\n  \"latitude\": \"<double>\",\n  \"longitude\": \"<double>\",\n  \"outletId\": \"<uuid>\",\n  \"isDeleted\": \"<boolean>\",\n  \"siteType\": \"<string>\",\n  \"customerType\": \"<string>\"\n}",
