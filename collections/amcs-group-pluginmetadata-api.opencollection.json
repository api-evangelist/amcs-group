            "params": [
              {
                "name": "type",
                "value": "",
                "type": "path"
              }
            ]
          }
        },
        {
          "info": {
            "name": "GET /plugins/metadata/plugins.json",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/plugins/metadata/plugins.json"
          }
        }
      ]
    }
  ],
  "bundled": true
}